# ACME_EMAIL: Email used for Let's Encrypt ACME registration and expiry notifications.
# Example: you@example.com
ACME_EMAIL=your-email@example.com

# TRAEFIK_NETWORK: Name of the external Docker network for services to connect.
# Default: proxy-public
# This network should be created before starting Traefik:
#   docker network create proxy-public
TRAEFIK_NETWORK=proxy-public

# TRAEFIK_ENTRYPOINT: Entry point for dashboard and services.
# Options:
#   - http      : Local development (HTTP only, redirects to HTTPS via docker-compose)
#   - websecure : Production server (HTTPS with TLS certificates)
# Default: websecure
TRAEFIK_ENTRYPOINT=websecure

# TRAEFIK_DASHBOARD_DOMAIN: Domain for Traefik dashboard router (optional).
# Used only if you create docker-compose.override.yml.
# Example: traefik.example.com
# TRAEFIK_DASHBOARD_DOMAIN=traefik.example.com

# Dashboard Basic Auth (optional):
# CI/CD preferred:
# - Variable: TRAEFIK_DASHBOARD_BASIC_AUTH_USER
# - Secret/masked: TRAEFIK_DASHBOARD_BASIC_AUTH_PASSWORD
# The deploy workflow generates a bcrypt htpasswd line on the server and writes docker-compose.override.yml.
