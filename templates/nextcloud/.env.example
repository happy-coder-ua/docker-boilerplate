PROJECT_NAME=nextcloud
DOMAIN_NAME=nextcloud.example.com
TRAEFIK_NETWORK=proxy-public
TRAEFIK_ENTRYPOINT=websecure

MYSQL_DATABASE=nextcloud
MYSQL_USER=nextcloud
MYSQL_PASSWORD=change-me-db-pass
MYSQL_ROOT_PASSWORD=change-me-root-pass

NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=change-me-admin-pass

TRUSTED_PROXIES=172.16.0.0/12
OVERWRITEPROTOCOL=https
OVERWRITECLIURL=https://nextcloud.example.com
